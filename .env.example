# Beemaster LiteLLM — Environment Variables
# Kopiere diese Datei nach .env und fülle die Werte aus.

# DeepInfra API Key (für Nemotron LLM Model)
DEEPINFRA_API_KEY=your-deepinfra-api-key

# LiteLLM Master Key (Admin-Zugang für LiteLLM UI/API)
# Generieren mit: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-beemaster-master-CHANGE-ME

# Supabase Konfiguration (für Custom Auth + Credit Callback)
SUPABASE_URL=https://your-project.supabase.co
INTERNAL_API_KEY=your-internal-secret-key

# PostgreSQL Password (für LiteLLM interne DB — Spend-Logs)
# Generieren mit: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-to-strong-password

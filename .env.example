# Environment variables for Railway deployment
# Copy to Railway Dashboard → Service → Variables

# DeepInfra API Key (get from https://deepinfra.com/)
DEEPINFRA_API_KEY=your-deepinfra-api-key

# LiteLLM Master Key (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=your-master-key

# Beemaster Backend URL
BEEMASTER_BACKEND_URL=https://beemaster-backend.cleanerx.workers.dev

# Internal API Key (same as in Beemaster Backend)
INTERNAL_API_KEY=your-internal-secret-key

# Database URL (auto-filled by Railway when you add PostgreSQL)
# DATABASE_URL=${{Postgres.DATABASE_URL}}